{
  "name": "QuantumShield \u2014 Interstate Quantum Hackathon 2026",
  "dataset": "NSL-KDD (public GitHub mirror)",
  "train_source": "https://raw.githubusercontent.com/Jehuty4949/NSL_KDD/master/KDDTrain%2B_20Percent.txt",
  "test_source": "https://raw.githubusercontent.com/Jehuty4949/NSL_KDD/master/KDDTest%2B.txt",
  "train_per_class": 80,
  "test_per_class": 100,
  "features": [
    "src_bytes",
    "dst_bytes",
    "count",
    "srv_serror_rate"
  ],
  "seed": 42,
  "qubits": 4,
  "reps": 2,
  "cv_folds": 3,
  "cv_lambda_candidates": [
    0.25,
    0.5,
    1.0
  ],
  "cv_C_candidates": [
    0.1,
    1.0,
    10.0
  ],
  "cv_gamma_candidates": [
    "scale",
    0.1,
    1.0
  ],
  "selected_classical_params": {
    "C": 10.0,
    "gamma": "scale"
  },
  "selected_quantum_params": {
    "Quantum Z QSVC": {
      "lambda": 1.0,
      "C": 10.0
    },
    "Quantum ZZ QSVC": {
      "lambda": 0.5,
      "C": 1.0
    }
  },
  "models": [
    "Classical RBF SVM",
    "Quantum ZZ QSVC",
    "Quantum Z QSVC"
  ],
  "timing_note": "fit_seconds excludes hyperparameter search and inference",
  "evaluation_note": "exploratory results; the held-out test subset was examined during earlier runs",
  "hardware": "classical statevector simulator \u2014 no quantum hardware"
}